# Installed by pi/install-server.sh (which fills in the @…@ values).
[Unit]
Description=Receives drive recordings from car_logger.py and the ESP32 logger (log_server.py)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
# SSM_UPLOAD_TOKEN=… (root-only, so the token isn't in this world-readable file)
EnvironmentFile=@ENV@
ExecStart=/usr/bin/python3 -u @REPO@/log_server.py --dir @DIR@ --port @PORT@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
